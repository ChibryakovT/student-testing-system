{
  "info": {
    "name": "Электронная система тестирования студентов — API",
    "description": "Проверка REST API. Перед запуском задайте переменные teacherUser и teacherPassword (учётная запись преподавателя). Пароли в коллекции не хранятся.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Регистрация студента",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now();",
              "pm.collectionVariables.set(\"newUser\", \"pm_student_\" + suffix);",
              "pm.collectionVariables.set(\"newPassword\", \"Pm\" + suffix + \"x\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201 Created\", () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test(\"Создан студент, роль из запроса проигнорирована\", () => pm.expect(b.role).to.eql(\"STUDENT\"));",
              "pm.test(\"Хеш пароля не возвращается\", () => pm.expect(b).to.not.have.property(\"passwordHash\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{newUser}}\",\n  \"password\": \"{{newPassword}}\",\n  \"fullName\": \"Студент Postman\",\n  \"email\": \"{{newUser}}@example.com\",\n  \"groupName\": \"ПИ-21\",\n  \"role\": \"ADMIN\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
