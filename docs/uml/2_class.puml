@startuml class
!pragma layout smetana
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
title Диаграмма классов (модель предметной области и сервисы)

enum Role {
  ADMIN
  TEACHER
  STUDENT
}
enum QuestionType {
  SINGLE
  MULTIPLE
}
enum ControlForm {
  EXAM
  CREDIT
  GRADED_CREDIT
}
enum AttemptStatus {
  IN_PROGRESS
  FINISHED
}
enum ShowAnswers {
  NEVER
  AFTER_SUBMIT
  AFTER_LAST_ATTEMPT
}

class User {
  -id: Long
  -username: String
  -passwordHash: String
  -fullName: String
  -email: String
  -role: Role
  -recordBook: String
  -enabled: boolean
}
class Faculty {
  -name: String
}
class Department {
  -name: String
}
class StudyGroup {
  -name: String
  -course: Integer
  -specialty: String
}
class CurriculumItem {
  -semester: Integer
  -controlForm: ControlForm
}
class Lesson {
  -dayOfWeek: int
  -pairNo: int
  -weekType: WeekType
  -room: String
}
class Exam {
  -date: LocalDate
  -startTime: LocalTime
  -room: String
}
enum WeekType {
  EVERY
  NUMERATOR
  DENOMINATOR
}
class Subject {
  -id: Long
  -name: String
  -description: String
}
class Test {
  -id: Long
  -title: String
  -timeLimitMinutes: int
  -passingScore: int
  -published: boolean
  -shuffle: boolean
  -maxAttempts: Integer
  -showAnswers: ShowAnswers
  -manualRelease: boolean
  -retakeDelayMinutes: Integer
  +getMaxScore(): int
}
class Question {
  -id: Long
  -text: String
  -type: QuestionType
  -points: int
  -explanation: String
  +addOption(o: AnswerOption)
}
class AnswerOption {
  -id: Long
  -text: String
  -correct: boolean
}
class TestAttempt {
  -id: Long
  -status: AttemptStatus
  -startedAt: LocalDateTime
  -finishedAt: LocalDateTime
  -score: int
  -percent: int
  -passed: boolean
  -released: boolean
  -draft: String
}
class AttemptAnswer {
  -id: Long
  -correct: boolean
  -pointsEarned: int
}

class TestService {
  +search(q, subjectId, sort, user): List<Test>
  +create(form, user): Test
  +update(id, form, user): Test
  +delete(id, user)
}
class AttemptService {
  +start(testId, user): TestAttempt
  +submit(attemptId, answers, user): TestAttempt
  +saveDraft(attemptId, answers, user)
  +release(testId, user): int
  +answersVisible(attempt, user): boolean
  +nextAttemptAt(test, studentId): LocalDateTime
  +getResult(attemptId, user): TestAttempt
}
class ScheduleService {
  +grid(lessons): List<PairRow>
  +isNumerator(date): boolean
  +saveLesson(...)
  +saveExam(planId, date, time, room)
}
class ReportService {
  +summary(): DashboardSummary
  +testStatistics(subjectId): List<TestStatRow>
  +testStatisticsCsv(subjectId): String
  +questionQuality(testId): Map<Long, QuestionQuality>
}

Subject "1" -- "0..*" Test
User "1" -- "0..*" Test : автор >
Test "1" *-- "1..*" Question
Question "1" *-- "2..*" AnswerOption
User "1" -- "0..*" TestAttempt : студент >
Test "1" -- "0..*" TestAttempt
TestAttempt "1" *-- "0..*" AttemptAnswer
AttemptAnswer "0..*" -- "1" Question
AttemptAnswer "0..*" -- "0..*" AnswerOption : выбранные >
User ..> Role
Faculty "1" -- "0..*" Department
Faculty "1" -- "0..*" StudyGroup
Department "1" -- "0..*" Subject
StudyGroup "1" -- "0..*" User : студенты >
StudyGroup "1" -- "0..*" CurriculumItem
Subject "1" -- "0..*" CurriculumItem
CurriculumItem "0..*" -- "0..1" User : преподаватель >
CurriculumItem "1" -- "0..1" Exam
StudyGroup "1" -- "0..*" Lesson
Lesson ..> WeekType
CurriculumItem ..> ControlForm
ScheduleService ..> Lesson
ScheduleService ..> Exam
Question ..> QuestionType
TestAttempt ..> AttemptStatus
Test ..> ShowAnswers
TestService ..> Test
AttemptService ..> TestAttempt
ReportService ..> TestAttempt
@enduml
