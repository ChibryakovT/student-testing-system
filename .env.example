# Скопируйте этот файл в .env и задайте свои значения.
# Файл .env добавлен в .gitignore и в репозиторий не попадает.

DB_URL=jdbc:postgresql://localhost:5432/testing_system
DB_USERNAME=testing_app
DB_PASSWORD=change_me

# Учётная запись администратора, создаётся при первом запуске
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Демонстрационные данные (преподаватель, студенты, тесты, результаты)
DEMO_DATA=true
DEMO_PASSWORD=change_me
DEMO_TEACHER_PASSWORD=change_me

# Настройки сервера (см. docs/DEPLOY.md)
# true — если приложение работает за HTTPS
COOKIE_SECURE=false
# 127.0.0.1 — принимать запросы только от nginx на этом же сервере
SERVER_ADDRESS=0.0.0.0
# true — кешировать шаблоны (для сервера)
THYMELEAF_CACHE=false
